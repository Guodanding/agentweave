# .env
# HF_HOME=/workspace/hf
SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=1

PERFORMANCE_SAVE_DIR=/workspace/agentweave/script/performance/

# max batch size
BATCH_SIZE=30

# rag kb_rag rpg deep_search
AGENT_TYPE=rag

# Knowledge Base RAG
KB_LLM_PATH=/workspace/models/Qwen3-32B
KB_EMBED_PATH=/workspace/models/Qwen3-Embedding-8B
KB_RERANKER_PATH=/workspace/models/Qwen3-Reranker-8B
KB_PROFILE_LLM_PATH=/workspace/agentweave/profile/kb_rag/profile_Qwen3_32B_TP4.pkl
KB_PROFILE_EMBED_PATH=/workspace/agentweave/profile/kb_rag/profile_Qwen3_Embedding_8B_TP4.pkl
KB_PROFILE_RERANKER_PATH=/workspace/agentweave/profile/kb_rag/profile_Qwen3_Reranker_8B_TP4.pkl

# Deep Search
DR_LLM_PATH=/workspace/models/Qwen3-14B
DR_SMALL_LLM_PATH=/workspace/models/Qwen3-4B
DR_LLM_MEM_FRACTION_STATIC=0.6
DR_SMALL_LLM_MEM_FRACTION_STATIC=0.7
DR_PROFILE_LLM_PATH=/workspace/agentweave/profile/deep_search/profile_Qwen3_14B.pkl
DR_PROFILE_SMALL_LLM_PATH=/workspace/agentweave/profile/deep_search/profile_Qwen3_4B.pkl
DR_PROFILE_SMALL_LLM_DECODE_PATH=/workspace/agentweave/profile/deep_search/profile_d_Qwen3_4B.pkl
BRAVE_API_KEY=


# RPG
RPG_LLM_PATH=/workspace/models/Qwen3-14B
RPG_DIFFUSION_PATH=/workspace/models/stable-diffusion-3-medium-diffusers
RPG_PROFILE_LLM_PATH=/workspace/agentweave/profile/rpg/profile_llm_d.pkl
RPG_PROFILE_DIFFUSION_PATH=/workspace/agentweave/profile/rpg/profile_diffusion.pkl

T_OVERHEAD_FILE=/workspace/agentweave/profile/profile_overhead.pkl

KB_INDEX_PATH=/workspace/agentweave/kb/my_kb.faiss
KB_METADATA_PATH=/workspace/agentweave/kb/my_kb_meta.pkl

# Document RAG
RAG_LLM_PATH=/workspace/models/Qwen3-32B
RAG_EMBED_PATH=/workspace/models/Qwen3-Embedding-8B
RAG_RERANKER_PATH=/workspace/models/Qwen3-Reranker-8B
RAG_PROFILE_LLM_PATH=/workspace/agentweave/profile/rag/profile_Qwen3_32B_TP4.pkl
RAG_PROFILE_EMBED_PATH=/workspace/agentweave/profile/rag/profile_Qwen3_Embedding_8B_TP4.pkl
RAG_PROFILE_RERANKER_PATH=/workspace/agentweave/profile/rag/profile_Qwen3_Reranker_8B_TP4.pkl
